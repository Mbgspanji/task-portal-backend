PORT=5000
NODE_ENV=production

# ─── Database (PostgreSQL Cloud / Neon / Supabase) ────────────
# Gunakan connection string untuk cloud database:
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_SSL=true

# Atau via variabel terpisah:
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=secure_task_db
# DB_PASSWORD=your_password
# DB_PORT=5432
# DB_SSL=false

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_long_random_jwt_secret_key_at_least_64_characters
JWT_EXPIRES_IN=8h

# ─── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=https://project-study-one.vercel.app

# ─── Gmail SMTP (OTP Verification) ───────────────────────────
# Wajib diisi di Environment Variables Vercel!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=baguspanjiofficial@gmail.com
SMTP_PASS=wkuh csyv svpq ovtr
MAIL_FROM_EMAIL=baguspanjiofficial@gmail.com
MAIL_FROM_NAME=SecureTask Portal
