PORT=5000
NODE_ENV=development

# PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=secure_task_db
DB_PASSWORD=your_db_password_here
DB_PORT=5432
DB_SSL=false

# For cloud DB (Neon/Supabase), uncomment and use:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=true

# JWT
JWT_SECRET=generate_a_long_random_secret_here_at_least_64_chars
JWT_EXPIRES_IN=8h

# CORS — set to your Vercel frontend URL
FRONTEND_URL=https://secure-task-portal.vercel.app
