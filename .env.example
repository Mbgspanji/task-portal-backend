PORT=5000
NODE_ENV=development

# PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=secure_task_db
DB_PASSWORD=your_db_password_here
DB_PORT=5432
DB_SSL=false

# For cloud DB (Neon/Supabase), uncomment and use:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=true

# JWT
JWT_SECRET=generate_a_long_random_secret_here_at_least_64_chars
JWT_EXPIRES_IN=8h

# CORS — set to your frontend URL
FRONTEND_URL=http://localhost:5173

# Mailtrap Configuration (Email Token Verification)
# Option A: SMTP (Mailtrap Sandbox / Testing)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_smtp_username
MAILTRAP_PASS=your_mailtrap_smtp_password

# Option B: Mailtrap API (optional, alternative to SMTP)
# MAILTRAP_TOKEN=your_mailtrap_api_token
# MAILTRAP_INBOX_ID=your_inbox_id

# Mail Sender Details
MAIL_FROM_EMAIL=no-reply@securetask.local
MAIL_FROM_NAME=SecureTask Portal
